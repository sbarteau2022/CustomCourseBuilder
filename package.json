{
  "name": "custom-course-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Custom education courses in coding with intelligence and ethics as first-class citizens. Elle witnesses the learning experience in real time and adapts program and pace to the learner.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && node --experimental-strip-types src/build.ts",
    "validate": "node --experimental-strip-types src/validate.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "elle": "node --experimental-strip-types src/cli.ts",
    "validate:curriculum": "node --experimental-strip-types src/validate-curriculum.ts",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.116.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
